
<div class="space-y-8">

  <!-- Page heading -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">
      School Dashboard
    </h1>
    <p class="mt-1 text-sm text-gray-500">
      Overview of students and teachers
    </p>
  </div>

  <button
    type="button"
    (click)="loadDashboard()"
    [disabled]="loading"
    class="rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
  >
    {{ loading ? 'Refreshing...' : 'Refresh Dashboard' }}
  </button>
</div>

  <!-- Error message -->
  @if (errorMessage) {
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      {{ errorMessage }}
    </div>
  }

  <!-- Loading state -->
  @if (loading) {
    <div class="rounded-xl border border-gray-200 bg-white p-8 text-center">
      <p class="text-gray-500">Loading dashboard information...</p>
    </div>
  } @else {

    <!-- Statistics cards -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">

      <!-- Students card -->
      <a
        routerLink="/students"
        class="group rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
      >
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500">
              Total Students
            </p>

            <p class="mt-3 text-4xl font-bold text-gray-900">
              {{ totalStudents }}
            </p>

            <p class="mt-3 text-sm font-medium text-blue-600">
              Manage students →
            </p>
          </div>

          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-blue-100 text-2xl">
            🎓
          </div>
        </div>
      </a>

      <!-- Teachers card -->
      <a
        routerLink="/teachers"
        class="group rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
      >
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500">
              Total Teachers
            </p>

            <p class="mt-3 text-4xl font-bold text-gray-900">
              {{ totalTeachers }}
            </p>

            <p class="mt-3 text-sm font-medium text-purple-600">
              Manage teachers →
            </p>
          </div>

          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-purple-100 text-2xl">
            👩‍🏫
          </div>
        </div>
      </a>

    </div>
  }

  <!-- Quick actions -->
  <section>
    <h2 class="text-lg font-semibold text-gray-900">
      Quick Actions
    </h2>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">

      <a
        routerLink="/students"
        class="flex items-center justify-between rounded-xl border border-gray-200 bg-white p-5 transition hover:border-blue-300 hover:bg-blue-50"
      >
        <div>
          <p class="font-semibold text-gray-900">Student Management</p>
          <p class="mt-1 text-sm text-gray-500">
            Register, edit, and remove students.
          </p>
        </div>
        <span class="text-xl text-gray-400">→</span>
      </a>

      <a
        routerLink="/teachers"
        class="flex items-center justify-between rounded-xl border border-gray-200 bg-white p-5 transition hover:border-purple-300 hover:bg-purple-50"
      >
        <div>
          <p class="font-semibold text-gray-900">Teacher Management</p>
          <p class="mt-1 text-sm text-gray-500">
            Register, edit, and remove teachers.
          </p>
        </div>
        <span class="text-xl text-gray-400">→</span>
      </a>

    </div>
  </section>




  <!-- Recent Students -->
  <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 p-5">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">
          Recent Students
        </h2>
        <p class="mt-1 text-sm text-gray-500">
          A quick look at student records.
        </p>
      </div>

      <a
        routerLink="/students"
        class="text-sm font-semibold text-blue-600 hover:text-blue-800"
      >
        View all students →
      </a>
    </div>

    @if (recentStudents.length > 0) {
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-gray-50 text-gray-500">
            <tr>
              <th class="px-5 py-3 font-semibold">Student</th>
              <th class="px-5 py-3 font-semibold">Age</th>
              <th class="px-5 py-3 font-semibold">Class</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">
            @for (student of recentStudents; track student.id) {
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-4 font-medium text-gray-900">
                  {{ student.fullname }}
                </td>
                <td class="px-5 py-4 text-gray-600">
                  {{ student.age }}
                </td>
                <td class="px-5 py-4 text-gray-600">
                  {{ student.className }}
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    } @else {
      <p class="p-6 text-center text-sm text-gray-500">
        No students to display yet.
      </p>
    }
  </section>
</div>